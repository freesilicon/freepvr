#version 460
// SPDX-License-Identifier: Apache-2.0
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer ProbeBuf {
    uint in_a[256];
    uint in_b[256];
    uint in_c[256];
    uint out_v[256];
} buf;
void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint a = buf.in_a[idx];
    uint b = buf.in_b[idx];
    if ((a & 1u) != 0u) {
        buf.out_v[idx] = a * b + 3u;
    } else {
        buf.out_v[idx] = (a ^ b) - 7u;
    }
}
