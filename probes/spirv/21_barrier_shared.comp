#version 460
// SPDX-License-Identifier: Apache-2.0
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) buffer ProbeBuf {
    uint in_a[256];
    uint in_b[256];
    uint in_c[256];
    uint out_v[256];
} buf;
shared uint smem[128];
void main() {
    uint lid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    smem[lid] = buf.in_a[gid];
    barrier();
    buf.out_v[gid] = smem[127u - lid];
}
